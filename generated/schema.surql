-- ════════════════════════════════════════════════════════════════════
-- Designer / lifecycle tables (runtime, not DocTypes)
-- ════════════════════════════════════════════════════════════════════

-- ── fn_source ─────────────────────────────────────────────────────────────────
-- Stores user-authored SurrealQL function bodies for the DocType designer.
DEFINE TABLE IF NOT EXISTS fn_source SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS fn_name     ON fn_source TYPE string;
DEFINE FIELD IF NOT EXISTS doctype     ON fn_source TYPE string;
DEFINE FIELD IF NOT EXISTS stage       ON fn_source TYPE string;
DEFINE FIELD IF NOT EXISTS code        ON fn_source TYPE string;
DEFINE FIELD IF NOT EXISTS description ON fn_source TYPE option<string>;
DEFINE FIELD IF NOT EXISTS tags        ON fn_source TYPE option<array<string>>;
DEFINE FIELD IF NOT EXISTS modified_at ON fn_source TYPE datetime VALUE time::now();
DEFINE INDEX IF NOT EXISTS fn_source_doctype ON fn_source FIELDS doctype;
